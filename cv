# -----------------------------
# Table Driven Vacuum Agent
# -----------------------------
class TableDrivenVacuumAgent:
    def _init_(self):
        self.table = {
            ('A', 'Dirty'): 'Suck',
            ('A', 'Clean'): 'Right',
            ('B', 'Dirty'): 'Suck',
            ('B', 'Clean'): 'Left'
        }

    def perceive(self, location, status):
        return (location, status)

    def act(self, percept):
        return self.table.get(percept, 'NoOp')


# -----------------------------
# Simple Reflex Vacuum Agent
# -----------------------------
class SimpleReflexVacuumAgent:
    def perceive(self, location, status):
        return (location, status)

    def act(self, percept):
        location, status = percept
        if status == 'Dirty':
            return 'Suck'
        elif location == 'A':
            return 'Right'
        else:
            return 'Left'


# -----------------------------
# Model Based Reflex Vacuum Agent
# -----------------------------
class ModelBasedReflexVacuumAgent:
    def _init_(self):
        self.model = {'A': 'Unknown', 'B': 'Unknown'}

    def perceive(self, location, status):
        self.model[location] = status
        return (location, status)

    def act(self, percept):
        location, status = percept
        if status == 'Dirty':
            return 'Suck'
        elif location == 'A':
            return 'Right'
        else:
            return 'Left'


# -----------------------------
# Vacuum Environment
# -----------------------------
class VacuumEnvironment:
    def _init_(self, initial_states):
        self.locations = initial_states.copy()
        self.agent_location = 'A'

    def get_status(self):
        return self.locations[self.agent_location]

    def perform_action(self, action):
        if action == 'Suck':
            self.locations[self.agent_location] = 'Clean'
        elif action == 'Right':
            self.agent_location = 'B'
        elif action == 'Left':
            self.agent_location = 'A'

    def is_clean(self):
        return all(status == 'Clean' for status in self.locations.values())


# -----------------------------
# Main Program
# -----------------------------
if _name_ == "_main_":

    # Input
    initial_states = {
        'A': input("Enter status of location A (Clean/Dirty): "),
        'B': input("Enter status of location B (Clean/Dirty): ")
    }

    # Agents
    table_agent = TableDrivenVacuumAgent()
    simple_agent = SimpleReflexVacuumAgent()
    model_agent = ModelBasedReflexVacuumAgent()

    # -----------------------------
    # Run Table Driven Agent
    # -----------------------------
    environment = VacuumEnvironment(initial_states)
    print("\nRunning Table-Driven Agent:")
    steps = 0

    while not environment.is_clean():
        location = environment.agent_location
        status = environment.get_status()
        percept = table_agent.perceive(location, status)
        action = table_agent.act(percept)
        print(f"Step {steps + 1}: At {location} ({status}), Action: {action}")
        environment.perform_action(action)
        steps += 1

    print("Environment is clean.")

    # -----------------------------
    # Run Simple Reflex Agent
